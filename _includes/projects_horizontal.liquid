{% assign card_project = include.project | default: project %}
{% assign card_variant = include.variant | default: card_project.card_size | default: 'standard' %}
{% assign card_status_kind = card_project.status_kind | default: 'ongoing' %}

<article class="research-card research-card--{{ card_variant }}">
  <div class="research-card__top">
    <span class="research-card__status research-card__status--{{ card_status_kind }}">
      {{ card_project.status -}}
      {%- if card_project.venue %} · {{ card_project.venue }}{% endif %}
    </span>
    {% if card_project.card_index %}
      <span class="research-card__index">{{ card_project.card_index }}</span>
    {% endif %}
  </div>

  <h3 class="research-card__title">{{ card_project.card_title | default: card_project.title }}</h3>
  <p class="research-card__question">{{ card_project.question | default: card_project.description }}</p>

  {% if card_project.metrics %}
    <div class="research-card__metrics">
      {% for metric in card_project.metrics %}
        <span class="research-metric">
          {% if metric.value -%}
            <strong>{{ metric.value }}</strong>
          {%- endif %}
          {{ metric.label }}
        </span>
      {% endfor %}
    </div>
  {% endif %}

  <div class="research-card__footer">
    {% if card_project.tags %}
      <div class="research-card__tags" aria-label="Methods">
        {% for tag in card_project.tags %}
          <span class="research-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <a class="research-text-link" href="{{ card_project.url | relative_url }}">Read project →</a>
  </div>
</article>
