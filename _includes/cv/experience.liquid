{% comment %}
  Reviewer-friendly experience renderer for RenderCV and JSONResume data.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush cv-entry-list">
  {% for entry in entries %}
    {% assign start_date = entry.start_date | default: entry.startDate | strip %}
    {% assign end_date = entry.end_date | default: entry.endDate | default: 'Present' | strip %}
    {% assign start_parts = start_date | split: '-' %}
    {% assign end_parts = end_date | split: '-' %}

    {% capture start_label %}
      {% if start_parts.size == 2 %}
        {{ start_date | append: '-01' | date: '%b %Y' }}
      {% else %}
        {{ start_date }}
      {% endif %}
    {% endcapture %}

    {% capture end_label %}
      {% if end_parts.size == 2 %}
        {{ end_date | append: '-01' | date: '%b %Y' }}
      {% else %}
        {{ end_date }}
      {% endif %}
    {% endcapture %}

    {% assign start_label = start_label | strip %}
    {% assign end_label = end_label | strip %}
    {% assign position_title = entry.position | default: entry.title %}
    {% assign company_name = entry.name | default: entry.company | default: entry.organization %}

    <li class="list-group-item cv-entry">
      <div class="cv-entry-header">
        <div class="cv-entry-main">
          {% if position_title %}
            <h5 class="cv-entry-title">
              {% if entry.url %}
                <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ position_title }}</a>
              {% else %}
                {{ position_title }}
              {% endif %}
            </h5>
          {% endif %}

          {% if company_name %}
            <div class="cv-entry-organization">{{ company_name }}</div>
          {% endif %}

          {% if entry.location or entry.summary %}
            <div class="cv-entry-meta">
              {% if entry.location %}
                <span class="cv-entry-meta-item">
                  <i class="fa-solid fa-location-dot iconlocation"></i>
                  {{ entry.location }}
                </span>
              {% endif %}

              {% if entry.summary %}
                <span class="cv-entry-meta-item cv-entry-advisor">
                  {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if start_label != blank %}
          <span class="badge cv-date-badge">
            {{ start_label }}
            {% if end_label != blank %}&ndash;{{ end_label }}{% endif %}
          </span>
        {% endif %}
      </div>

      {% if entry.highlights %}
        <ul class="items cv-entry-highlights">
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
