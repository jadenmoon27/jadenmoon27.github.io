{% comment %}
  Reviewer-friendly education renderer for RenderCV and JSONResume data.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush cv-entry-list">
  {% for entry in entries %}
    {% assign start_date = entry.start_date | default: entry.startDate | strip %}
    {% assign end_date = entry.end_date | default: entry.endDate | strip %}
    {% assign start_parts = start_date | split: '-' %}
    {% assign end_parts = end_date | split: '-' %}
    {% assign study_type = entry.studyType | default: entry.degree | strip %}

    {% capture start_label %}
      {% if start_parts.size == 2 %}
        {{ start_date | append: '-01' | date: '%b %Y' }}
      {% else %}
        {{ start_date }}
      {% endif %}
    {% endcapture %}

    {% capture end_label %}
      {% if end_parts.size == 2 %}
        {{ end_date | append: '-01' | date: '%b %Y' }}
      {% else %}
        {{ end_date }}
      {% endif %}
    {% endcapture %}

    {% capture degree_label %}
      {% if study_type != blank and entry.area %}
        {{ study_type }} in {{ entry.area }}
      {% elsif study_type != blank %}
        {{ study_type }}
      {% elsif entry.area %}
        {{ entry.area }}
      {% endif %}
    {% endcapture %}

    {% assign start_label = start_label | strip %}
    {% assign end_label = end_label | strip %}
    {% assign degree_label = degree_label | strip %}

    <li class="list-group-item cv-entry">
      <div class="cv-entry-header">
        <div class="cv-entry-main">
          {% if entry.institution %}
            <h5 class="cv-entry-title">
              {% if entry.url %}
                <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.institution }}</a>
              {% else %}
                {{ entry.institution }}
              {% endif %}
            </h5>
          {% endif %}

          {% if degree_label != blank %}
            <div class="cv-entry-organization">{{ degree_label }}</div>
          {% endif %}

          {% if entry.location %}
            <div class="cv-entry-meta">
              <span class="cv-entry-meta-item">
                <i class="fa-solid fa-location-dot iconlocation"></i>
                {{ entry.location }}
              </span>
            </div>
          {% endif %}
        </div>

        {% if start_label != blank %}
          <span class="badge cv-date-badge">
            {{ start_label }}
            {% if end_label != blank %}&ndash;{{ end_label }}{% endif %}
          </span>
        {% endif %}
      </div>

      {% if entry.highlights %}
        <div class="cv-inline-details">
          {% for item in entry.highlights %}
            <span>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            {% unless forloop.last %}
              <span class="cv-inline-separator" aria-hidden="true">&middot;</span>
            {% endunless %}
          {% endfor %}
        </div>
      {% endif %}

      {% if entry.courses %}
        <div class="cv-coursework">
          <strong>Relevant coursework:</strong>
          {% for item in entry.courses %}
            {{ item -}}
            {%- unless forloop.last %}, {% endunless %}
          {% endfor %}
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
